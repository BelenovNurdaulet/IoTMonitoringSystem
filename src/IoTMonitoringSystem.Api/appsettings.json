{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Username=iotuser;Password=iotpass;Database=iotdb"
  },


  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "IoTMonitoringSystem.Api"
    }
  }
}
